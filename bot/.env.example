BOT_TOKEN=123456789:YOUR_TELEGRAM_BOT_TOKEN

# Comma-separated list of Telegram User IDs allowed to use the bot
ALLOWED_USERS=123456789,987654321

# Optional: explicit owner ID for privileged commands like /add_user.
# If unset, the first entry in ALLOWED_USERS is treated as the owner.
OWNER_ID=123456789

# qBittorrent Configuration
QBITTORRENT_URL=http://localhost:8080
QBITTORRENT_USER=admin
# IMPORTANT: change this — "adminadmin" is the qBittorrent factory default.
QBITTORRENT_PASS=adminadmin

# Polling interval in seconds
POLL_INTERVAL=10
